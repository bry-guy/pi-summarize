{
  "name": "pi-summarize",
  "version": "0.2.1",
  "description": "Pi extension: live one-line activity summaries and auto-titled sessions, using a cheap side model.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "summary",
    "session-title"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bry-guy/pi-summarize.git"
  },
  "homepage": "https://github.com/bry-guy/pi-summarize#readme",
  "bugs": {
    "url": "https://github.com/bry-guy/pi-summarize/issues"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^1.3.0"
  }
}
